!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# environment files
.env

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# SECURITY: Archivos críticos para ciberseguridad
# Credenciales y certificados
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer
*.jks
*.keystore
secrets.json
credentials.json
config/secrets.*
.secrets/
private/
certs/

# Archivos de backup que pueden contener datos sensibles
*.backup
*.bak
*.old
*.orig
*.save
*.swp
*.tmp
*~
.backup/
backups/

# Logs que pueden contener información sensible
*.log
logs/
*.log.*
log.*
audit.log
access.log
error.log
security.log
.logs/

# Archivos de dump y depuración
*.dump
*.dmp
*.stackdump
core.*
*.pid
*.seed
*.pid.lock

# Configuraciones locales con información sensible
.vscode/settings.json
.idea/
*.sublime-workspace
*.sublime-project
.local/
local.config.*
*.local.*

# Archivos temporales del sistema
.DS_Store
Thumbs.db
Desktop.ini
.directory

# Archivos de profiling y análisis
*.prof
*.cpuprofile
*.heapsnapshot
coverage/
.nyc_output

# Archivos de testing con datos sensibles
test-results/
test-data/
*.test.log
fixtures/real-data/

# Archivos de despliegue con secretos
docker-compose.override.yml
k8s-secrets.yml
.deployment/
deployment-secrets.*

# ESPECÍFICO DE EQUINOX ENTERPRISE
# Base de datos local de desarrollo (si se regenera)
*.sqlite
*.sqlite3
*.db
dev.db*

# Archivos de inspecciones sensibles (datos reales)
inspecciones-reales/
datos-clientes/
informes-confidenciales/

# Configuraciones de Airtable con tokens reales
airtable-config.json
airtable-backup/

# Archivos de usuarios reales (testing)
usuarios-reales.*
test-users-prod.*
seed-data-prod.*

# vercel
.vercel

# typescript
*.tsbuildinfo
